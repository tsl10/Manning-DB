<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Experience - KAMI MARINE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f8fafc; color: #0f172a; padding: 24px;
        }
        .container { max-width: 700px; margin:0 auto; }
        header {
            background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;
            margin-bottom: 24px; display:flex; justify-content: space-between; align-items:center;
        }
        .logo { font-size:24px; font-weight:700; color:#0f172a; text-decoration:none; }
        .btn {
            padding:10px 18px; border-radius:6px; font-weight:500; font-size:14px; cursor:pointer; text-decoration:none;
            transition:all 0.2s ease; border:none;
        }
        .btn-outline { background: transparent; color:#0f172a; border:1px solid #e2e8f0; }
        .btn-outline:hover { background-color:#f8fafc; border-color:#cbd5e1; }
        .btn-primary { background-color:#0f172a; color:#ffffff; }
        .btn-primary:hover { background-color:#1e293b; }
        .page-header { margin-bottom:24px; }
        .page-header h1 { font-size:28px; font-weight:700; }
        .page-header a { color:#3b82f6; text-decoration:none; font-weight:600; }
        .form-container {
            background-color:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:32px;
        }
        .form-group { margin-bottom:20px; display:flex; flex-direction:column; }
        .form-group label { font-size:14px; font-weight:600; margin-bottom:8px; color:#334155; }
        .form-group input, .form-group select {
            padding:12px 16px; border:1px solid #e2e8f0; border-radius:8px; font-size:15px; color:#0f172a;
            background-color:#ffffff; transition:all 0.2s ease;
        }
        .form-group input:focus, .form-group select:focus {
            outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,0.1);
        }
        .form-actions { display:flex; gap:16px; margin-top:32px; }
        .form-actions .btn { padding:12px 24px; font-size:15px; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">KAMI MARINE</a>
            <div style="display:flex; gap:12px;">
                <a href="/dashboard" class="btn btn-outline">Back to Dashboard</a>
                <a href="/logout" class="btn btn-outline">Logout</a>
            </div>
        </header>
        <div class="page-header">
            <a href="/dashboard">← Back</a>
            <h1>Add Experience</h1>
        </div>
        <div class="form-container">
            <form method="POST" action="/experience/add">
                <div class="form-group">
                    <label>Company Name *</label>
                    <input type="text" name="company_name" required>
                </div>
                <div class="form-group">
                    <label>Vessel Name *</label>
                    <input type="text" name="vessel_name" required>
                </div>
                <div class="form-group">
                    <label>Vessel Type *</label>
                    <select name="type" required>
                        <option value="">Select Vessel Type</option>
                        <option value="Bulk Carrier">Bulk Carrier</option>
                        <option value="General Cargo Ship">General Cargo Ship</option>
                        <option value="Cargo Ship">Cargo Ship</option>
                        <option value="Container Ship">Container Ship</option>
                        <option value="Cement Carrier">Cement Carrier</option>
                        <option value="Log Carrier">Log Carrier</option>
                        <option value="Woodchip Carrier">Woodchip Carrier</option>
                        <option value="Reefer Vessel">Reefer Vessel</option>
                        <option value="Chemical Tanker">Chemical Tanker</option>
                        <option value="Crude Oil Tanker">Crude Oil Tanker</option>
                        <option value="Oil Tanker">Oil Tanker</option>
                        <option value="Product Tanker">Product Tanker</option>
                        <option value="LPG Tanker">LPG Tanker</option>
                        <option value="LNG Tanker">LNG Tanker</option>
                        <option value="Bitumen Carrier">Bitumen Carrier</option>
                        <option value="Ro-Ro Vessel">Ro-Ro Vessel</option>
                        <option value="PC/PT Carrier">PC/PT Carrier</option>
                        <option value="Anchor Handling Vessel">Anchor Handling Vessel</option>
                        <option value="Offshore Support Vessel">Offshore Support Vessel</option>
                        <option value="DP Vessel">DP Vessel</option>
                        <option value="Cable Laying Vessel">Cable Laying Vessel</option>
                        <option value="Floating Crane">Floating Crane</option>
                        <option value="Oil Platform">Oil Platform</option>
                        <option value="Oil Rig">Oil Rig</option>
                        <option value="Dredger">Dredger</option>
                        <option value="Tug Boat">Tug Boat</option>
                        <option value="Hovercraft">Hovercraft</option>
                        <option value="Icebreaker">Icebreaker</option>
                        <option value="Cruise Ship">Cruise Ship</option>
                        <option value="Fishing Vessel">Fishing Vessel</option>
                        <option value="Trawler">Trawler</option>
                        <option value="Research Vessel">Research Vessel</option>
                        <option value="Sailing Vessel">Sailing Vessel</option>
                        <option value="Yacht">Yacht</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Rank *</label>
                    <input type="text" name="rank" required>
                </div>
                <div class="form-group">
                    <label>Sign-On Date *</label>
                    <input type="date" name="sign_on" required>
                </div>
                <div class="form-group">
                    <label>Sign-Off Date *</label>
                    <input type="date" name="sign_off" required>
                </div>
                <div class="form-actions">
                    <a href="/dashboard" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary">Add Experience</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
