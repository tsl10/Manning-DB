<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Medical Certificates - KAMI MARINE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background-color: #f8fafc; color: #0f172a; padding:24px; }
        .container { max-width: 800px; margin:0 auto; }
        header { background-color:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; }
        .logo { font-size:24px; font-weight:700; color:#0f172a; text-decoration:none; }
        .btn { padding:10px 18px; border-radius:6px; font-weight:500; font-size:14px; cursor:pointer; text-decoration:none; transition:all 0.2s ease; border:none; }
        .btn-outline { background: transparent; color:#0f172a; border:1px solid #e2e8f0; }
        .btn-outline:hover { background-color:#f8fafc; border-color:#cbd5e1; }
        .btn-primary { background-color:#0f172a; color:#ffffff; }
        .btn-primary:hover { background-color:#1e293b; }
        .page-header { margin-bottom:24px; }
        .page-header h1 { font-size:28px; font-weight:700; }
        .page-header a { color:#3b82f6; text-decoration:none; font-weight:600; }
        .form-container { background-color:#ffffff; border:1px solid #e2e8f0; border-radius:12px; padding:32px; }
        .section-title { font-size:18px; font-weight:700; margin:24px 0 16px; padding-bottom:12px; border-bottom:1px solid #e2e8f0; }
        .form-group { margin-bottom:20px; display:flex; flex-direction:column; }
        .form-group label { font-size:14px; font-weight:600; margin-bottom:8px; color:#334155; }
        .form-group input { padding:12px 16px; border:1px solid #e2e8f0; border-radius:8px; font-size:15px; color:#0f172a; background-color:#ffffff; transition:all 0.2s ease; }
        .form-group input:focus { outline:none; border-color:#3b82f6; box-shadow:0 0 0 3px rgba(59,130,246,0.1); }
        .checkbox-group { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
        .checkbox-group input { transform:scale(1.2); }
        .form-actions { display:flex; gap:16px; margin-top:32px; padding-top:24px; border-top:1px solid #e2e8f0; }
        .form-actions .btn { padding:12px 24px; font-size:15px; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">KAMI MARINE</a>
            <div style="display:flex; gap:12px;">
                <a href="/dashboard" class="btn btn-outline">Back to Dashboard</a>
                <a href="/logout" class="btn btn-outline">Logout</a>
            </div>
        </header>
        <div class="page-header">
            <a href="/dashboard">← Back</a>
            <h1>Add Medical Certificates</h1>
        </div>
        <div class="form-container">
            <form method="POST" action="/medical/add">
                <h3 class="section-title">Medical & Fitness Certificate</h3>
                <div class="checkbox-group">
                    <input type="checkbox" id="hasMedical" name="has_medical">
                    <label for="hasMedical" style="margin-bottom:0;">I have a Medical & Fitness Certificate</label>
                </div>
                <div id="medicalFields" style="display:none; margin-top:12px;">
                    <div class="form-group">
                        <label>Certificate Number</label>
                        <input type="text" name="medical_certificate_number">
                    </div>
                    <div class="form-group">
                        <label>Issued By</label>
                        <input type="text" name="medical_issued_by">
                    </div>
                    <div class="form-group">
                        <label>Issue Date</label>
                        <input type="date" name="medical_issue_date">
                    </div>
                    <div class="form-group">
                        <label>Expiry Date</label>
                        <input type="date" name="medical_expiry_date">
                    </div>
                </div>

                <h3 class="section-title">Yellow Fever Certificate</h3>
                <div class="checkbox-group">
                    <input type="checkbox" id="hasYellowFever" name="has_yellow_fever">
                    <label for="hasYellowFever" style="margin-bottom:0;">I have a Yellow Fever Certificate</label>
                </div>
                <div id="yellowFeverFields" style="display:none; margin-top:12px;">
                    <div class="form-group">
                        <label>Certificate Number</label>
                        <input type="text" name="yf_certificate_number">
                    </div>
                    <div class="form-group">
                        <label>Issued By</label>
                        <input type="text" name="yf_issued_by">
                    </div>
                    <div class="form-group">
                        <label>Issue Date</label>
                        <input type="date" name="yf_issue_date">
                    </div>
                    <div class="form-group">
                        <label>Expiry Date</label>
                        <input type="date" name="yf_expiry_date">
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/dashboard" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Certificates</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const hasMedical = document.getElementById('hasMedical');
        const medicalFields = document.getElementById('medicalFields');
        hasMedical.addEventListener('change', () => {
            medicalFields.style.display = hasMedical.checked ? 'block' : 'none';
        });
        const hasYellowFever = document.getElementById('hasYellowFever');
        const yellowFeverFields = document.getElementById('yellowFeverFields');
        hasYellowFever.addEventListener('change', () => {
            yellowFeverFields.style.display = hasYellowFever.checked ? 'block' : 'none';
        });
    </script>
</body>
</html>
