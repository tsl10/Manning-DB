<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Crew Member - KAMI MARINE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 24px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            border: none;
        }

        .btn-outline {
            background-color: transparent;
            color: #0f172a;
            border: 1px solid #e2e8f0;
        }

        .btn-outline:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }

        .btn-primary {
            background-color: #0f172a;
            color: #ffffff;
        }

        .btn-primary:hover {
            background-color: #1e293b;
        }

        .page-header {
            margin-bottom: 24px;
        }

        .page-header a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
        }

        .form-container {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 32px;
        }

        .section {
            margin-bottom: 48px;
            padding-bottom: 32px;
            border-bottom: 1px solid #e2e8f0;
        }

        .section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid #e2e8f0;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 15px;
            color: #0f172a;
            background-color: #ffffff;
            transition: all 0.2s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

        .form-actions {
            display: flex;
            gap: 16px;
            margin-top: 40px;
            padding-top: 32px;
            border-top: 2px solid #e2e8f0;
        }

        .form-actions .btn {
            padding: 14px 28px;
            font-size: 15px;
        }

        @media (max-width: 768px) {
            body {
                padding: 16px;
            }

            .form-container {
                padding: 20px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .page-header h1 {
                font-size: 22px;
            }

            .form-actions {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">KAMI MARINE</a>
            <div style="display: flex; gap: 12px;">
                <a href="/admin/dashboard" class="btn btn-outline">Back to Dashboard</a>
                <a href="/logout" class="btn btn-outline">Logout</a>
            </div>
        </header>

        <div class="page-header">
            <a href="/admin/crew/<%= user.user_id %>">← Back to Crew Details</a>
            <h1>Edit <%= user.fname %> <%= user.lname %></h1>
        </div>

        <div class="form-container">
            <form method="POST" action="/admin/crew/<%= user.user_id %>/edit">
                <!-- 1. Applicant Details -->
                <div class="section">
                    <h3 class="section-title">Applicant Details</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="fname" value="<%= user.fname %>" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" name="lname" value="<%= user.lname %>">
                        </div>
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" name="email" value="<%= user.email %>" required>
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select Gender</option>
                                <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="text" name="phone_number" value="<%= user.phone_number %>">
                        </div>
                        <div class="form-group">
                            <label>Department</label>
                            <select id="department" name="department">
                                <option value="">Select Department</option>
                                <option value="Deck" <%= user.department === 'Deck' ? 'selected' : '' %>>Deck</option>
                                <option value="Engine" <%= user.department === 'Engine' ? 'selected' : '' %>>Engine</option>
                                <option value="Catering" <%= user.department === 'Catering' ? 'selected' : '' %>>Catering</option>
                                <option value="Specialist" <%= user.department === 'Specialist' ? 'selected' : '' %>>Specialist</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Rank</label>
                            <select id="rank" name="rank">
                                <option value="">Select Rank</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Date Available</label>
                            <input type="date" name="date_available" value="<%= user.date_available %>">
                        </div>
                    </div>
                </div>

                <!-- 2. Personal Information -->
                <div class="section">
                    <h3 class="section-title">Personal Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Date of Birth</label>
                            <input type="date" name="date_of_birth" value="<%= user.date_of_birth %>">
                        </div>
                        <div class="form-group">
                            <label>Place of Birth</label>
                            <input type="text" name="place_of_birth" value="<%= user.place_of_birth %>">
                        </div>
                        <div class="form-group">
                            <label>Nationality</label>
                            <input type="text" name="nationality" value="<%= user.nationality %>">
                        </div>
                        <div class="form-group">
                            <label>Height (cm)</label>
                            <input type="number" name="height_cm" value="<%= user.height_cm %>">
                        </div>
                        <div class="form-group">
                            <label>Weight (kg)</label>
                            <input type="number" name="weight_kg" value="<%= user.weight_kg %>">
                        </div>
                        <div class="form-group">
                            <label>Eye Color</label>
                            <input type="text" name="eye_color" value="<%= user.eye_color %>">
                        </div>
                        <div class="form-group">
                            <label>Marital Status</label>
                            <select name="marital_status">
                                <option value="">Select Marital Status</option>
                                <option value="Single" <%= user.marital_status === 'Single' ? 'selected' : '' %>>Single</option>
                                <option value="Married" <%= user.marital_status === 'Married' ? 'selected' : '' %>>Married</option>
                                <option value="Divorced" <%= user.marital_status === 'Divorced' ? 'selected' : '' %>>Divorced</option>
                                <option value="Widowed" <%= user.marital_status === 'Widowed' ? 'selected' : '' %>>Widowed</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Father Name</label>
                            <input type="text" name="father_name" value="<%= user.father_name %>">
                        </div>
                    </div>
                </div>

                <!-- 3. Home Address -->
                <div class="section">
                    <h3 class="section-title">Home Address</h3>
                    <div class="form-group">
                        <label>Home Address</label>
                        <textarea name="home_address"><%= user.home_address %></textarea>
                    </div>
                </div>

                <!-- 4. Passport Information -->
                <div class="section">
                    <h3 class="section-title">Passport Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Passport Number</label>
                            <input type="text" name="passport_number" value="<%= user.passport?.number %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" id="passport_issue_date" name="passport_issue_date" value="<%= user.passport?.issue_date %>" max="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" id="passport_expiry_date" name="passport_expiry_date" value="<%= user.passport?.expiry_date %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Place</label>
                            <input type="text" name="passport_place_of_issue" value="<%= user.passport?.place_of_issue %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="passport_issued_by" value="<%= user.passport?.issued_by %>">
                        </div>
                    </div>
                </div>

                <!-- 5. Seaman Book -->
                <div class="section">
                    <h3 class="section-title">Seaman Book</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Seaman Book No</label>
                            <input type="text" name="seaman_book_number" value="<%= user.seaman_book?.number %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" id="seaman_book_issue_date" name="seaman_book_issue_date" value="<%= user.seaman_book?.issue_date %>" max="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" id="seaman_book_expiry_date" name="seaman_book_expiry_date" value="<%= user.seaman_book?.expiry_date %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="seaman_book_issued_by" value="<%= user.seaman_book?.issued_by %>">
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/admin/crew/<%= user.user_id %>" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Department -> Rank mapping
        const ranks = {
            'Deck': ['Master', 'Additional Master', 'Chief Officer', '2nd Officer', '3rd Officer', 'Junior Deck Officer', 'Radio Officer', 'Security Officer', 'Trainee Officer', 'Deck Watchkeeper', 'Cadet Deck', 'Pumpman', 'Bosun', 'Deck Welder', 'Able Seaman', 'Ordinary Seaman', 'Deck Boy', 'Tug Mate', 'Tug Master', 'Crane Operator'],
            'Engine': ['Chief Engineer', 'Chief Electrical Engineer', '2nd Engineer', '2nd Asst Engineer', '3rd Engineer', '3rd Asst Engineer', '4th Engineer', '5th Engineer', 'Cargo Gas Engineer', 'Electrical Engineer', 'ETO', 'Electronics Engineer', 'Electrician', 'Junior Engineer', 'Trainee Engineer', 'Cadet Engine', 'Fitter', 'Motorman', 'Oiler', 'Wiper', 'Engine Boy'],
            'Specialist': ['Medic', 'Carpenter', 'Repairman', 'Security Guard', 'Ship Clerk', 'Staff Captain', 'Supercargo', 'Fireman', 'Repair Supervisor', 'Leading Hand', 'Deck Super', 'Eng Super', 'Supernumerary', 'Pilot', 'Relief Master', 'Riding Team Deck', 'Riding Team Eng', 'Other'],
            'Catering': ['Chief Cook', '2nd Cook', '3rd Chef', '4th Chef', 'Assistant Cook', 'Cook/Steward', 'Catering Assistant', 'Purser', 'Chief Steward', 'Steward/(Ess)', 'Cabin Stewardess', 'Messman', 'Chief Housekeeper', 'Housekeeper', 'Laundryman']
        };

        const departmentSelect = document.getElementById('department');
        const rankSelect = document.getElementById('rank');
        const currentRank = '<%= user.rank %>';

        function updateRankOptions() {
            const selectedDept = departmentSelect.value;
            rankSelect.innerHTML = '<option value="">Select Rank</option>';
            if (selectedDept && ranks[selectedDept]) {
                ranks[selectedDept].forEach(r => {
                    const option = document.createElement('option');
                    option.value = r;
                    option.textContent = r;
                    if (r === currentRank) option.selected = true;
                    rankSelect.appendChild(option);
                });
            }
        }
        updateRankOptions();
        departmentSelect.addEventListener('change', updateRankOptions);

        // Auto-calculate expiry dates (10 years from issue date)
        function addYearsToDate(dateStr, years) {
            if (!dateStr) return '';
            const date = new Date(dateStr);
            if (isNaN(date)) return '';
            date.setFullYear(date.getFullYear() + years);
            return date.toISOString().split('T')[0];
        }

        // Passport expiry auto-calculation
        const passportIssueInput = document.getElementById('passport_issue_date');
        const passportExpiryInput = document.getElementById('passport_expiry_date');
        if (passportIssueInput && passportExpiryInput) {
            passportIssueInput.addEventListener('change', function() {
                passportExpiryInput.value = addYearsToDate(this.value, 10);
            });
        }

        // Seaman book expiry auto-calculation
        const seamanIssueInput = document.getElementById('seaman_book_issue_date');
        const seamanExpiryInput = document.getElementById('seaman_book_expiry_date');
        if (seamanIssueInput && seamanExpiryInput) {
            seamanIssueInput.addEventListener('change', function() {
                seamanExpiryInput.value = addYearsToDate(this.value, 10);
            });
        }
    </script>
</body>
</html>
