                <!-- 9. Medical & Fitness Certificate -->
                <div class="section">
                    <h3 class="section-title">Medical & Fitness Certificate</h3>
                    <% if (user.medical_cert?.has_medical) { %>
                        <h4 class="subsection-title">Medical Certificate</h4>
                        <div class="list-item">
                            <div class="list-item-grid">
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Certificate Number</div>
                                    <div><%= user.medical_cert?.medical?.certificate_number || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Issued By</div>
                                    <div><%= user.medical_cert?.medical?.issued_by || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Issue Date</div>
                                    <div><%= user.medical_cert?.medical?.issue_date || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Expiry Date</div>
                                    <div><%= user.medical_cert?.medical?.expiry_date || '-' %></div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    <% if (user.medical_cert?.has_yellow_fever) { %>
                        <h4 class="subsection-title">Yellow Fever Certificate</h4>
                        <div class="list-item">
                            <div class="list-item-grid">
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Certificate Number</div>
                                    <div><%= user.medical_cert?.yellow_fever?.certificate_number || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Issued By</div>
                                    <div><%= user.medical_cert?.yellow_fever?.issued_by || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Issue Date</div>
                                    <div><%= user.medical_cert?.yellow_fever?.issue_date || '-' %></div>
                                </div>
                                <div class="list-item-field">
                                    <div class="list-item-field-label">Expiry Date</div>
                                    <div><%= user.medical_cert?.yellow_fever?.expiry_date || '-' %></div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    <h4 class="subsection-title">Update Medical Certificates</h4>
                    <div class="checkbox-group">
                        <input type="checkbox" id="has_medical" name="has_medical" <%= user.medical_cert?.has_medical ? 'checked' : '' %>>
                        <label for="has_medical" style="margin-bottom:0; font-weight:600;">I have a Medical & Fitness Certificate</label>
                    </div>
                    <div id="medical_fields" class="form-grid <%= user.medical_cert?.has_medical ? 'visible-grid' : 'hidden' %>">
                        <div class="form-group">
                            <label>Certificate Number</label>
                            <input type="text" name="med_certificate_number" value="<%= user.medical_cert?.medical?.certificate_number %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="med_issued_by" value="<%= user.medical_cert?.medical?.issued_by %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" name="med_issue_date" value="<%= user.medical_cert?.medical?.issue_date %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="med_expiry_date" value="<%= user.medical_cert?.medical?.expiry_date %>">
                        </div>
                    </div>
                    <div class="checkbox-group" style="margin-top:24px;">
                        <input type="checkbox" id="has_yellow_fever" name="has_yellow_fever" <%= user.medical_cert?.has_yellow_fever ? 'checked' : '' %>>
                        <label for="has_yellow_fever" style="margin-bottom:0; font-weight:600;">I have a Yellow Fever Certificate</label>
                    </div>
                    <div id="yellow_fever_fields" class="form-grid <%= user.medical_cert?.has_yellow_fever ? 'visible-grid' : 'hidden' %>">
                        <div class="form-group">
                            <label>Certificate Number</label>
                            <input type="text" name="yf_certificate_number" value="<%= user.medical_cert?.yellow_fever?.certificate_number %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="yf_issued_by" value="<%= user.medical_cert?.yellow_fever?.issued_by %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" name="yf_issue_date" value="<%= user.medical_cert?.yellow_fever?.issue_date %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="yf_expiry_date" value="<%= user.medical_cert?.yellow_fever?.expiry_date %>">
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/dashboard" class="btn btn-outline">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save All Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Department -> Rank mapping
        const ranks = {
            'Deck': ['Master', 'Additional Master', 'Chief Officer', '2nd Officer', '3rd Officer', 'Junior Deck Officer', 'Radio Officer', 'Security Officer', 'Trainee Officer', 'Deck Watchkeeper', 'Cadet Deck', 'Pumpman', 'Bosun', 'Deck Welder', 'Able Seaman', 'Ordinary Seaman', 'Deck Boy', 'Tug Mate', 'Tug Master', 'Crane Operator'],
            'Engine': ['Chief Engineer', 'Chief Electrical Engineer', '2nd Engineer', '2nd Asst Engineer', '3rd Engineer', '3rd Asst Engineer', '4th Engineer', '5th Engineer', 'Cargo Gas Engineer', 'Electrical Engineer', 'ETO', 'Electronics Engineer', 'Electrician', 'Junior Engineer', 'Trainee Engineer', 'Cadet Engine', 'Fitter', 'Motorman', 'Oiler', 'Wiper', 'Engine Boy'],
            'Specialist': ['Medic', 'Carpenter', 'Repairman', 'Security Guard', 'Ship Clerk', 'Staff Captain', 'Supercargo', 'Fireman', 'Repair Supervisor', 'Leading Hand', 'Deck Super', 'Eng Super', 'Supernumerary', 'Pilot', 'Relief Master', 'Riding Team Deck', 'Riding Team Eng', 'Other'],
            'Catering': ['Chief Cook', '2nd Cook', '3rd Chef', '4th Chef', 'Assistant Cook', 'Cook/Steward', 'Catering Assistant', 'Purser', 'Chief Steward', 'Steward/(Ess)', 'Cabin Stewardess', 'Messman', 'Chief Housekeeper', 'Housekeeper', 'Laundryman']
        };

        // Initialize rank dropdown
        const departmentSelect = document.getElementById('department');
        const rankSelect = document.getElementById('rank');
        const currentRank = '<%= user.rank %>';

        // Update rank options when department changes
        function updateRankOptions() {
            const selectedDept = departmentSelect.value;
            rankSelect.innerHTML = '<option value="">Select Rank</option>';
            if (selectedDept && ranks[selectedDept]) {
                ranks[selectedDept].forEach(r => {
                    const option = document.createElement('option');
                    option.value = r;
                    option.textContent = r;
                    if (r === currentRank) option.selected = true;
                    rankSelect.appendChild(option);
                });
            }
        }
        updateRankOptions();
        departmentSelect.addEventListener('change', updateRankOptions);

        const completionBarFill = document.querySelector('.completion-bar-fill');
        if (completionBarFill && completionBarFill.dataset.progress) {
            completionBarFill.style.width = `${completionBarFill.dataset.progress}%`;
        }

        // Toggle medical fields
        document.getElementById('has_medical').addEventListener('change', function() {
            document.getElementById('medical_fields').style.display = this.checked ? 'grid' : 'none';
        });
        document.getElementById('has_yellow_fever').addEventListener('change', function() {
            document.getElementById('yellow_fever_fields').style.display = this.checked ? 'grid' : 'none';
        });

        // Compute and display age when date of birth is selected
        function computeAge(dobStr) {
            if (!dobStr) return '';
            const dob = new Date(dobStr);
            if (isNaN(dob)) return '';
            const today = new Date();
            let age = today.getFullYear() - dob.getFullYear();
            const m = today.getMonth() - dob.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < dob.getDate())) age--;
            return age >= 0 ? age : '';
        }

        const dobInput = document.getElementById('date_of_birth');
        const ageDisplay = document.getElementById('age_display');
        function updateAgeDisplay() {
            const age = computeAge(dobInput.value);
            ageDisplay.textContent = age ? `Age: ${age} years` : '';
        }
        if (dobInput) {
            dobInput.addEventListener('change', updateAgeDisplay);
            // initialize on load
            updateAgeDisplay();
        }

        // Auto-calculate expiry dates (10 years from issue date)
        function addYearsToDate(dateStr, years) {
            if (!dateStr) return '';
            const date = new Date(dateStr);
            if (isNaN(date)) return '';
            date.setFullYear(date.getFullYear() + years);
            return date.toISOString().split('T')[0];
        }

        // Passport expiry auto-calculation
        const passportIssueInput = document.querySelector('input[name="passport_issue_date"]');
        const passportExpiryInput = document.querySelector('input[name="passport_expiry_date"]');
        if (passportIssueInput && passportExpiryInput) {
            passportIssueInput.addEventListener('change', function() {
                passportExpiryInput.value = addYearsToDate(this.value, 10);
            });
        }

        // Seaman book expiry auto-calculation
        const seamanIssueInput = document.querySelector('input[name="seaman_book_issue_date"]');
        const seamanExpiryInput = document.querySelector('input[name="seaman_book_expiry_date"]');
        if (seamanIssueInput && seamanExpiryInput) {
            seamanIssueInput.addEventListener('change', function() {
                seamanExpiryInput.value = addYearsToDate(this.value, 10);
            });
        }

        // Yellow fever certificate expiry auto-calculation
        const yfIssueInput = document.querySelector('input[name="yf_issue_date"]');
        const yfExpiryInput = document.querySelector('input[name="yf_expiry_date"]');
        if (yfIssueInput && yfExpiryInput) {
            yfIssueInput.addEventListener('change', function() {
                yfExpiryInput.value = addYearsToDate(this.value, 10);
            });
        }

        // Profile Photo Face Detection
        let detectedFace = true;
        let faceValidationFailed = false;
        const hasExistingProfilePhoto = document.getElementById('photoSection').dataset.hasProfilePhoto === 'true';
        const profilePhotoInput = document.getElementById('profilePhotoInput');
        const photoPreview = document.getElementById('photoPreview');
        const faceDetectionStatus = document.getElementById('faceDetectionStatus');
        const faceDetectionCanvas = document.getElementById('faceDetectionCanvas');

        function updateFaceStatus(message, className) {
            faceDetectionStatus.innerHTML = `<span class="${className}">${message}</span>`;
        }

        async function detectFaces(imageElement) {
            updateFaceStatus('⏳ Validating photo...', 'status-warning');
            faceValidationFailed = false;

            try {
                const detectionPromise = new Promise(async (resolve, reject) => {
                    const timeoutId = setTimeout(() => reject(new Error('Detection timeout')), 5000);

                    if (typeof tf === 'undefined' || typeof faceDetection === 'undefined') {
                        clearTimeout(timeoutId);
                        resolve(null);
                        return;
                    }

                    try {
                        const model = faceDetection.SupportedModels.BlazeFace;
                        const detectorConfig = { maxFaces: 5 };
                        const detector = await faceDetection.createDetector(model, detectorConfig);
                        const predictions = await detector.estimateFaces(imageElement, false);
                        clearTimeout(timeoutId);
                        resolve(predictions);
                    } catch (err) {
                        clearTimeout(timeoutId);
                        reject(err);
                    }
                });

                const predictions = await detectionPromise;

                if (predictions === null) {
                    detectedFace = true;
                    updateFaceStatus('✓ Photo loaded. If your face is clearly visible, this image is acceptable.', 'status-success');
                } else if (predictions.length === 0) {
                    detectedFace = true;
                    updateFaceStatus('⚠ Automatic detection could not find a face. If the photo clearly shows only your face, you can still use it.', 'status-warning');
                } else if (predictions.length === 1) {
                    detectedFace = true;
                    updateFaceStatus('✓ Face detected. This photo looks good.', 'status-success');
                } else {
                    detectedFace = false;
                    faceValidationFailed = true;
                    updateFaceStatus(`❌ Multiple faces detected (${predictions.length}). Please upload a single headshot.`, 'status-danger');
                }
            } catch (error) {
                console.error('Face detection error:', error);
                detectedFace = true;
                faceValidationFailed = false;
                updateFaceStatus('⚠ Photo validation could not complete. If your face is clearly visible, it is acceptable.', 'status-warning');
            }
        }

        profilePhotoInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    faceDetectionStatus.innerHTML = '<span style="color: #ef4444;">❌ File size too large. Max 5MB allowed.</span>';
                    profilePhotoInput.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        // Update preview
                        if (typeof photoPreview.src === 'string') {
                            photoPreview.src = event.target.result;
                            photoPreview.style.width = '200px';
                            photoPreview.style.height = '250px';
                            photoPreview.style.borderRadius = '8px';
                            photoPreview.style.objectFit = 'cover';
                            photoPreview.style.border = '2px solid #e2e8f0';
                        } else {
                            photoPreview.innerHTML = '';
                            const newImg = document.createElement('img');
                            newImg.src = event.target.result;
                            newImg.style.width = '200px';
                            newImg.style.height = '250px';
                            newImg.style.borderRadius = '8px';
                            newImg.style.objectFit = 'cover';
                            newImg.style.border = '2px solid #e2e8f0';
                            photoPreview.appendChild(newImg);
                        }

                        // Detect faces
                        detectFaces(img);
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Prevent form submission if photo not properly validated
        document.querySelector('form').addEventListener('submit', function(e) {
            if (profilePhotoInput.files.length === 0 && !hasExistingProfilePhoto) {
                e.preventDefault();
                alert('Please upload a profile photo before saving.');
            } else if (faceValidationFailed) {
                e.preventDefault();
                alert('Multiple faces were detected in the selected photo. Please upload a single-person headshot.');
            }
        });
    </script>
</body>
</html>