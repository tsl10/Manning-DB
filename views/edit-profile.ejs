<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile - KAMI MARINE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script async src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4"></script>
    <script async src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-detection@2"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
            padding: 24px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        header {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
        }
        .btn {
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            border: none;
        }
        .btn-outline {
            background-color: transparent;
            color: #0f172a;
            border: 1px solid #e2e8f0;
        }
        .btn-outline:hover {
            background-color: #f8fafc;
            border-color: #cbd5e1;
        }
        .btn-primary {
            background-color: #0f172a;
            color: #ffffff;
        }
        .btn-primary:hover {
            background-color: #1e293b;
        }
        .btn-small {
            padding: 6px 12px;
            font-size: 13px;
        }
        .page-header {
            margin-bottom: 24px;
        }
        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
        }
        .page-header a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 600;
        }
        .form-container {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 32px;
        }
        .section {
            margin-bottom: 48px;
            padding-bottom: 32px;
            border-bottom: 1px solid #e2e8f0;
        }
        .section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }
        .section-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid #e2e8f0;
        }
        .subsection-title {
            font-size: 16px;
            font-weight: 600;
            margin: 24px 0 16px 0;
            color: #475569;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
        }
        .form-group label {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #334155;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 16px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 15px;
            color: #0f172a;
            background-color: #ffffff;
            transition: all 0.2s ease;
        }
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }
        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }
        .checkbox-group input {
            transform: scale(1.3);
        }
        .list-item {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 16px;
        }
        .list-item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }
        .list-item-title {
            font-size: 16px;
            font-weight: 600;
        }
        .list-item-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
        }
        .list-item-field {
            font-size: 14px;
        }
        .list-item-field-label {
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 4px;
        }
        .empty-state {
            text-align: center;
            padding: 24px;
            color: #64748b;
            background-color: #f8fafc;
            border-radius: 8px;
            border: 1px dashed #cbd5e1;
        }
        .form-actions {
            display: flex;
            gap: 16px;
            margin-top: 40px;
            padding-top: 32px;
            border-top: 2px solid #e2e8f0;
        }
        .form-actions .btn {
            padding: 14px 28px;
            font-size: 15px;
        }
        .completion-bar-fill {
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, #3b82f6 0%, #10b981 100%);
            transition: width 0.3s ease;
        }
        .photo-guide-button {
            background-color: #1d4ed8;
            color: #ffffff;
            border: none;
            padding: 12px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 700;
            font-size: 14px;
            transition: background-color 0.2s ease;
        }
        .photo-guide-button:hover {
            background-color: #2563eb;
        }
        .photo-guide-modal {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(15, 23, 42, 0.65);
            z-index: 9999;
            padding: 24px;
        }
        .photo-guide-panel {
            width: min(100%, 720px);
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
            overflow: hidden;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }
        .photo-guide-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 18px;
            padding: 28px;
            border-bottom: 1px solid #e2e8f0;
        }
        .photo-guide-header h2 {
            margin: 0;
            font-size: 22px;
            color: #0f172a;
        }
        .photo-guide-subtitle {
            margin: 8px 0 0;
            color: #475569;
            line-height: 1.7;
            max-width: 560px;
        }
        .photo-guide-close-btn {
            border: 1px solid #cbd5e1;
            background: #f8fafc;
            color: #0f172a;
            padding: 10px 16px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
        }
        .photo-guide-section {
            padding: 24px 28px;
        }
        .photo-guide-section h3 {
            margin: 0 0 18px;
            font-size: 18px;
            color: #0f172a;
        }
        .photo-example-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }
        .photo-example-card {
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            overflow: hidden;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
        }
        .photo-example-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
            display: block;
        }
        .photo-example-text {
            padding: 14px 16px 18px;
            color: #334155;
            font-size: 13px;
            line-height: 1.6;
        }
        .photo-guide-note {
            padding: 18px 28px 28px;
            color: #334155;
            font-size: 14px;
            line-height: 1.75;
            background: #f8fafc;
        }
        .status-success {
            color: #0f766e;
        }
        .status-warning {
            color: #92400e;
        }
        .status-danger {
            color: #b91c1c;
        }
        .photo-help-text {
            color: #475569;
            margin-top: 8px;
            display: block;
            font-size: 14px;
            line-height: 1.65;
        }
        .hidden {
            display: none !important;
        }
        .visible-grid {
            display: grid !important;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/" class="logo">KAMI MARINE</a>
            <div style="display: flex; gap: 12px;">
                <a href="/dashboard" class="btn btn-outline">Back to Dashboard</a>
                <a href="/logout" class="btn btn-outline">Logout</a>
            </div>
        </header>
        <div class="page-header">
            <a href="/dashboard">← Back</a>
            <h1>Edit Profile</h1>
        </div>
        <!-- Profile Completion (always shown) -->
        <div class="card" style="margin-bottom: 24px;">
            <div style="font-size: 14px; font-weight: 600; margin-bottom: 12px; color: #64748b;">Profile Completion</div>
            <%
                let completedFieldsEdit = 0;
                let totalFieldsEdit = 0;
                
                const requiredFieldsEdit = [
                    user.fname, user.lname, user.email, user.phone_number, user.date_of_birth,
                    user.place_of_birth, user.nationality, user.gender, user.height_cm, user.weight_kg,
                    user.eye_color, user.marital_status, user.father_name, user.home_address,
                    user.passport?.number, user.seaman_book?.number,
                    user.profile_photo, user.experiences?.length > 0 ? 1 : 0,
                    user.certificates?.length > 0 ? 1 : 0, user.licences?.length > 0 ? 1 : 0,
                    user.medical_cert?.has_medical ? 1 : 0
                ];
                
                requiredFieldsEdit.forEach(field => {
                    totalFieldsEdit++;
                    if (field) completedFieldsEdit++;
                });
                
                const completionPercentEdit = Math.round((completedFieldsEdit / totalFieldsEdit) * 100);
            %>
            <div style="margin-bottom: 8px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span style="font-size: 14px; color: #0f172a;"><strong><%= completionPercentEdit %>%</strong> Complete</span>
                    <span style="font-size: 13px; color: #64748b;"><%= completedFieldsEdit %> of <%= totalFieldsEdit %> fields</span>
                </div>
                <div style="width: 100%; height: 24px; background-color: #e2e8f0; border-radius: 12px; overflow: hidden;">
                    <div class="completion-bar-fill" data-progress="<%= completionPercentEdit %>"></div>
                </div>
            </div>
        </div>
        <div class="form-container">
            <form method="POST" action="/profile/edit" enctype="multipart/form-data">
                <!-- 0. Profile Photo -->
                <div class="section" id="photoSection" data-has-profile-photo="<%= user.profile_photo ? 'true' : 'false' %>">
                    <h3 class="section-title">Profile Photo</h3>
                    
                    <!-- Guide Button -->
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: start;">
                        <div>
                            <div class="form-group">
                                <label>Upload Profile Photo *</label>
                                <input type="file" id="profilePhotoInput" name="profile_photo" accept="image/*" style="padding: 10px; border: 2px dashed #3b82f6;">
                                <small class="photo-help-text">
                                    ✓ Clear face centered in the frame<br>
                                    ✓ Neutral or light background<br>
                                    ✓ No sunglasses, hats or group photos<br>
                                    ✓ JPG or PNG format
                                </small>
                                <div id="faceDetectionStatus" style="margin-top: 12px; font-weight: 600; min-height: 30px;"></div>
                            </div>
                        </div>
                        <div>
                            <label style="font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px; display: block;">Photo Preview</label>
                            <% if (user.profile_photo) { %>
                                <img id="photoPreview" src="<%= user.profile_photo %>" style="width: 200px; height: 250px; border-radius: 8px; object-fit: cover; border: 2px solid #e2e8f0;">
                            <% } else { %>
                                <div id="photoPreview" style="width: 200px; height: 250px; background-color: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #94a3b8; text-align: center; padding: 16px;">
                                    Upload a photo to see preview
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <canvas id="faceDetectionCanvas" style="display: none;"></canvas>
                </div>

                <!-- 1. Applicant Details -->
                <div class="section">
                    <h3 class="section-title">Applicant Details</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="fname" value="<%= user.fname %>" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input type="text" name="lname" value="<%= user.lname %>">
                        </div>
                        <div class="form-group">
                            <label>Email *</label>
                            <input type="email" name="email" value="<%= user.email %>" required>
                        </div>
                        <div class="form-group">
                            <label>Gender</label>
                            <select name="gender">
                                <option value="">Select Gender</option>
                                <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                                <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="text" name="phone_number" value="<%= user.phone_number %>">
                        </div>
                        <div class="form-group">
                            <label>Department</label>
                            <select id="department" name="department">
                                <option value="">Select Department</option>
                                <option value="Deck" <%= user.department === 'Deck' ? 'selected' : '' %>>Deck</option>
                                <option value="Engine" <%= user.department === 'Engine' ? 'selected' : '' %>>Engine</option>
                                <option value="Catering" <%= user.department === 'Catering' ? 'selected' : '' %>>Catering</option>
                                <option value="Specialist" <%= user.department === 'Specialist' ? 'selected' : '' %>>Specialist</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Rank</label>
                            <select id="rank" name="rank">
                                <option value="">Select Rank</option>
                            </select>
                        </div>
                        <% const today = new Date();
                           const maxDob = new Date(today.getFullYear() - 18, today.getMonth(), today.getDate()).toISOString().split('T')[0];
                           const minAvailable = new Date(today);
                           minAvailable.setDate(minAvailable.getDate() + 1);
                        %>
                        <div class="form-group">
                            <label>Date Available</label>
                            <input type="date" name="date_available" value="<%= user.date_available %>" min="<%= minAvailable.toISOString().split('T')[0] %>">
                        </div>
                    </div>
                </div>

                <!-- 2. Personal Information -->
                <div class="section">
                    <h3 class="section-title">Personal Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Date of Birth * (must be 18+)</label>
                            <input id="date_of_birth" type="date" name="date_of_birth" value="<%= user.date_of_birth %>" required max="<%= maxDob %>">
                            <div id="age_display" style="margin-top:8px; color:#475569; font-weight:600;"></div>
                        </div>
                        <div class="form-group">
                            <label>Place of Birth</label>
                            <input type="text" name="place_of_birth" value="<%= user.place_of_birth %>">
                        </div>
                        <div class="form-group">
                            <label>Nationality</label>
                            <input type="text" name="nationality" value="<%= user.nationality %>">
                        </div>
                        <div class="form-group">
                            <label>Height (cm)</label>
                            <input type="number" name="height_cm" value="<%= user.height_cm %>">
                        </div>
                        <div class="form-group">
                            <label>Weight (kg)</label>
                            <input type="number" name="weight_kg" value="<%= user.weight_kg %>">
                        </div>
                        <div class="form-group">
                            <label>Eye Color</label>
                            <input type="text" name="eye_color" value="<%= user.eye_color %>">
                        </div>
                        <div class="form-group">
                            <label>Marital Status</label>
                            <select name="marital_status">
                                <option value="">Select Marital Status</option>
                                <option value="Single" <%= user.marital_status === 'Single' ? 'selected' : '' %>>Single</option>
                                <option value="Married" <%= user.marital_status === 'Married' ? 'selected' : '' %>>Married</option>
                                <option value="Divorced" <%= user.marital_status === 'Divorced' ? 'selected' : '' %>>Divorced</option>
                                <option value="Widowed" <%= user.marital_status === 'Widowed' ? 'selected' : '' %>>Widowed</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Father Name</label>
                            <input type="text" name="father_name" value="<%= user.father_name %>">
                        </div>
                    </div>
                </div>

                <!-- 3. Home Address -->
                <div class="section">
                    <h3 class="section-title">Home Address</h3>
                    <div class="form-group">
                        <label>Home Address</label>
                        <textarea name="home_address"><%= user.home_address %></textarea>
                    </div>
                </div>

                <!-- 4. Passport Information -->
                <div class="section">
                    <h3 class="section-title">Passport Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Passport Number</label>
                            <input type="text" name="passport_number" value="<%= user.passport?.number %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" name="passport_issue_date" value="<%= user.passport?.issue_date %>" max="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="passport_expiry_date" value="<%= user.passport?.expiry_date %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Place</label>
                            <input type="text" name="passport_place_of_issue" value="<%= user.passport?.place_of_issue %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="passport_issued_by" value="<%= user.passport?.issued_by %>">
                        </div>
                    </div>
                </div>

                <!-- 5. Seaman Book -->
                <div class="section">
                    <h3 class="section-title">Seaman Book</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Seaman Book No</label>
                            <input type="text" name="seaman_book_number" value="<%= user.seaman_book?.number %>">
                        </div>
                        <div class="form-group">
                            <label>Issue Date</label>
                            <input type="date" name="seaman_book_issue_date" value="<%= user.seaman_book?.issue_date %>" max="<%= new Date().toISOString().split('T')[0] %>">
                        </div>
                        <div class="form-group">
                            <label>Expiry Date</label>
                            <input type="date" name="seaman_book_expiry_date" value="<%= user.seaman_book?.expiry_date %>">
                        </div>
                        <div class="form-group">
                            <label>Issued By</label>
                            <input type="text" name="seaman_book_issued_by" value="<%= user.seaman_book?.issued_by %>">
                        </div>
                    </div>
                </div>

                <!-- 6. Experience -->
                <div class="section">
                    <h3 class="section-title">Experience</h3>
                    <% if (user.experiences && user.experiences.length > 0) { %>
                        <h4 class="subsection-title">Current Experience</h4>
                        <% user.experiences.forEach(exp => { %>
                            <div class="list-item">
                                <div class="list-item-header">
                                    <div class="list-item-title"><%= exp.vessel_name %> | <%= exp.rank %></div>
                                    <div style="font-weight: 600; color: #0f172a;"><%= exp.months %> Months</div>
                                </div>
                                <div class="list-item-grid">
                                    <div class="list-item-field">
                                        <div class="list-item-field-label">Company</div>
                                        <div><%= exp.company_name %></div>
                                    </div>
                                    <div class="list-item-field">
                                        <div class="list-item-field-label">Vessel Type</div>
                                        <div><%= exp.type %></div>
                                    </div>
                                    <div class="list-item-field">
                                        <div class="list-item-field-label">Sign On</div>
                                        <div><%= exp.sign_on %></div>
                                    </div>
                                    <div class="list-item-field">
                                        <div class="list-item-field-label">Sign Off</div>
                                        <div><%= exp.sign_off %></div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state">No experience added yet</div>
                    <% } %>
                    <h4 class="subsection-title">Add New Experience</h4>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Company Name</label>
                            <input type="text" name="new_exp_company_name">
                        </div>
                        <div class="form-group">
                            <label>Vessel Name</label>
                            <input type="text" name="new_exp_vessel_name">
                        </div>
                        <div class="form-group">
                            <label>Vessel Type</label>
                            <select name="new_exp_type">
                                <option value="">Select Vessel Type</option>
                                <option value="Bulk Carrier">Bulk Carrier</option>
                                <option value="General Cargo Ship">General Cargo Ship</option>
                                <option value="Cargo Ship">Cargo Ship</option>
                                <option value="Container Ship">Container Ship</option>
                                <option value="Cement Carrier">Cement Carrier</option>
                                <option value="Log Carrier">Log Carrier</option>
                                <option value="Woodchip Carrier">Woodchip Carrier</option>
                                <option value="Reefer Vessel">Reefer Vessel</option>
                                <option value="Chemical Tanker">Chemical Tanker</option>
                                <option value="Crude Oil Tanker">Crude Oil Tanker</option>
                                <option value="Oil Tanker">Oil Tanker</option>
                                <option value="Product Tanker">Product Tanker</option>
                                <option value="LPG Tanker">LPG Tanker</option>
                                <option value="LNG Tanker">LNG Tanker</option>
                                <option value="Bitumen Carrier">Bitumen Carrier</option>
                                <option value="Ro-Ro Vessel">Ro-Ro Vessel</option>
                                <option value="PC/PT Carrier">PC/PT Carrier</option>
                                <option value="Anchor Handling Vessel">Anchor Handling Vessel</option>
                                <option value="Offshore Support Vessel">Offshore Support Vessel</option>
                                <option value="DP Vessel">DP Vessel</option>
                                <option value="Cable Laying Vessel">Cable Laying Vessel</option>
                                <option value="Floating Crane">Floating Crane</option>
                                <option value="Oil Platform">Oil Platform</option>
                                <option value="Oil Rig">Oil Rig</option>
                                <option value="Dredger">Dredger</option>
                                <option value="Tug Boat">Tug Boat</option>
                                <option value="Hovercraft">Hovercraft</option>
