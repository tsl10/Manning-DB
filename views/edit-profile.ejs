                            <input type="text" name="new_lic_type">
                        </div>
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" name="new_lic_name">
                        </div>
                        <div class="form-group">
                            <label>Number</label>
                            <input type="text" name="new_lic_number">
                        </div>
                        <div class="form-group">
                            <label>Grade</label>
                            <input type="text" name="new_lic_grade">
                        </div>
