<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile - KAMI MARINE</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Header */
        header {
            border-bottom: 1px solid #e2e8f0;
            padding: 20px 0;
            background-color: #ffffff;
        }

        .nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            text-decoration: none;
        }

        .nav-links {
            display: flex;
            gap: 32px;
            align-items: center;
        }

        .nav-links a {
            color: #475569;
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
        }

        .nav-links a:hover {
            color: #0f172a;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 15px;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background-color: #facc15;
            color: #0f172a;
            border: none;
        }

        .btn-primary:hover {
            background-color: #eab308;
            transform: translateY(-1px);
        }

        .btn-outline {
            background-color: transparent;
            color: #0f172a;
            border: 1px solid #e2e8f0;
        }

        .btn-outline:hover {
            border-color: #cbd5e1;
            background-color: #f8fafc;
        }

        /* Profile Content */
        .profile-container {
            max-width: 800px;
            margin: 48px auto;
        }

        .profile-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 48px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .profile-header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 32px;
            border-bottom: 1px solid #e2e8f0;
        }

        .profile-avatar {
            width: 96px;
            height: 96px;
            background-color: #facc15;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            font-size: 36px;
            font-weight: 700;
            color: #0f172a;
        }

        .profile-header h1 {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #0f172a;
        }

        .profile-header p {
            font-size: 16px;
            color: #64748b;
        }

        .profile-section {
            margin-bottom: 32px;
        }

        .profile-section-title {
            font-size: 16px;
            font-weight: 600;
            color: #854d0e;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #fef9c3;
        }

        .profile-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .profile-item {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .profile-item-label {
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .profile-item-value {
            font-size: 15px;
            color: #1e293b;
            font-weight: 500;
            padding: 12px 16px;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .profile-actions {
            display: flex;
            gap: 16px;
            margin-top: 40px;
            padding-top: 32px;
            border-top: 1px solid #e2e8f0;
        }

        .btn-full {
            flex: 1;
            padding: 14px;
            font-size: 15px;
            text-align: center;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .profile-grid {
                grid-template-columns: 1fr;
            }

            .profile-card {
                padding: 32px 24px;
            }

            .profile-actions {
                flex-direction: column;
            }

            .nav-links {
                gap: 16px;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <nav class="nav">
                <a href="/" class="logo">KAMI MARINE</a>
                <div class="nav-links">
                    <a href="/profile">Profile</a>
                    <a href="/logout" class="btn btn-outline">Logout</a>
                </div>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="profile-container">
            <div class="profile-card">
                <div class="profile-header">
                    <div class="profile-avatar">
                        <%= user.FNAME.charAt(0).toUpperCase() + user.LNAME.charAt(0).toUpperCase() %>
                    </div>
                    <h1><%= user.FNAME %> <%= user.LNAME %></h1>
                    <p><%= user.position_applied %></p>
                </div>

                <div class="profile-section">
                    <div class="profile-section-title">Personal Information</div>
                    <div class="profile-grid">
                        <div class="profile-item">
                            <span class="profile-item-label">First Name</span>
                            <span class="profile-item-value"><%= user.FNAME %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Last Name</span>
                            <span class="profile-item-value"><%= user.LNAME %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Email</span>
                            <span class="profile-item-value"><%= user.EMAIL %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Gender</span>
                            <span class="profile-item-value"><%= user.GENDER %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Phone Number</span>
                            <span class="profile-item-value"><%= user.PHONE_NUMBER %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Position Applied</span>
                            <span class="profile-item-value"><%= user.position_applied %></span>
                        </div>
                        <div class="profile-item">
                            <span class="profile-item-label">Date Available</span>
                            <span class="profile-item-value"><%= user.date_available %></span>
                        </div>
                    </div>
                </div>

                <div class="profile-actions">
                    <a href="/" class="btn btn-outline btn-full">Back to Home</a>
                    <a href="/logout" class="btn btn-primary btn-full">Logout</a>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
